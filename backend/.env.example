NODE_ENV=development
APP_TIER=FREE
PORT=3000
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/absher_bi
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long-refresh
# أصول الواجهات (REST + WebSocket). ممنوع * في production
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Web Push: شغّل  npm run vapid:generate  والصق الناتج هنا (الاثنان معًا أو لا شيء)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
