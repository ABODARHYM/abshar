NODE_ENV=development
APP_TIER=FREE
PORT=3000
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/absher_bi
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long-refresh
# أصول الواجهات (REST + WebSocket). ممنوع * في production
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Web Push: شغّل  npm run vapid:generate  والصق الناتج هنا (الاثنان معًا أو لا شيء)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@absher-bi.com

# Delivery routing provider (required before distance-based quotes can be confirmed).
# Configure a trusted HTTPS endpoint accepting POST JSON:
# {"origin":{"latitude":15.4,"longitude":45.3},"destination":{"latitude":15.41,"longitude":45.31}}
# It must return JSON {"distanceKm": number} using ROAD distance in kilometers.
# Leave empty until a provider is selected; quotes fail closed (no straight-line fallback).
ROUTING_API_URL=
ROUTING_API_KEY=
