# ============================================================
# ABSHER BI - Environment variables
# انسخ هذا الملف إلى .env ثم غيّر كل القيم. لا ترفع .env إلى Git.
# ============================================================

# ---- Runtime -------------------------------------------------
# development | staging | production | test
NODE_ENV=development
# FREE | PRO  (الـ Backend هو المرجع الوحيد للـ Tier)
APP_TIER=FREE
PORT=3000
# اتركه false في production ما لم تحتج للتوثيق
SWAGGER_ENABLED=true

# ---- PostgreSQL (docker-compose) ------------------------------
POSTGRES_USER=absher
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=absher_bi_dev

# تشغيل Backend خارج Docker (npm run start:dev):
DATABASE_URL=postgresql://absher:change-me-db-password@localhost:5432/absher_bi_dev
DATABASE_POOL_MAX=10
# true عند استخدام قاعدة بيانات مُدارة تتطلب SSL
DATABASE_SSL=false

# ---- Auth -----------------------------------------------------
# 32 حرفًا على الأقل. ولّد قيمة عشوائية: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- HTTP -----------------------------------------------------
# قائمة مفصولة بفواصل. في production ضع النطاقات الحقيقية فقط.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---- Providers (تُستخدم في مراحل لاحقة) -----------------------
STORAGE_URL=
NOTIFICATION_CONFIG=

# ---- PRO only -------------------------------------------------
# مطلوب عندما APP_TIER=PRO
REDIS_URL=
